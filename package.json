{
  "name": "codex-reset-radar",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "基于 Tibo 公开言论的 Codex 额度重置预测与提醒桌面应用",
  "main": "electron/main.cjs",
  "author": "Codex Reset Radar",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.33.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.5",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.reset-radar.codex",
    "productName": "Codex Reset Radar",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon-1024.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-1024.png",
      "target": [
        "dmg"
      ],
      "artifactName": "Codex-Reset-Radar-${version}-${arch}.${ext}",
      "extraResources": [
        { "from": "build/codex-runtime/mac-${arch}", "to": "codex-runtime" }
      ]
    },
    "win": {
      "icon": "build/icon-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Codex-Reset-Radar-Setup-${version}.${ext}",
      "extraResources": [
        { "from": "build/codex-runtime/win-${arch}", "to": "codex-runtime" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@43.4.1": true
  }
}
